# Server Configuration
PORT=3000
# Production: your custom GoDaddy domain (no trailing slash)
BASE_URL=https://nfcscan4u.in

# Admin Access Key (Use this to access /admin)
ADMIN_KEY=admin1234

# Session secret for cookies
SESSION_SECRET=my-super-secret-random-key-change-in-production

# Database Configuration:
# - For local development: file:cards.db
# - For free cloud production (Vercel / Render / Railway): Free Turso SQLite (https://turso.tech)
DATABASE_URL=file:cards.db
# DATABASE_AUTH_TOKEN=your_turso_auth_token_if_using_turso_cloud
